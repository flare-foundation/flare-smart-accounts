# Base: Node.js LTS on Debian, includes npm & core build tools

# Use Debian base for glibc compatibility with Foundry
FROM node:24-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install only minimal deps required for Forge tests and scripts
# hadolint ignore=DL3008
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends ca-certificates curl git bash \
 && rm -rf /var/lib/apt/lists/*

# Install Foundry.
#
# Set this to a release tag - `stable`, a version like `v1.7.1`, or a full
# `nightly-<sha>` - to pin the toolchain, and retag the image when you change it.
# The default is concrete rather than `stable`. `stable` resolves at build time,
# so rebuilding would move forge underneath CI with no commit recording it - and
# it lags badly: it installed 1.5.1 while v1.8.3 was current. The published tag
# is built by hand, so git is the only place the version is written down. The
# bare `nightly` tag is not the latest nightly either - it resolved to a build
# ten weeks old when this was written - so pin the full `nightly-<sha>`.
#
# v1.8.3 is the first stable release with everything the consuming repos need:
# solar >= v0.2.0 (solc 0.8.35's `erc7201` builtin), foundry-rs/foundry#16100
# (coverage keyed by build ID) and #16098 (coverage of file-level functions).
ARG FOUNDRY_VERSION=v1.8.3

# The previous version of this ran `foundryup --version latest || true` followed
# by a bare `foundryup || true`. `--version` prints foundryup's own version and
# takes no argument, so the first call installed nothing, the second installed
# whatever was current, and the two `|| true`s hid both facts. Install once, and
# let a bad version fail the build.
ENV FOUNDRY_DIR=/root/.foundry
RUN curl -L https://foundry.paradigm.xyz | bash \
 && /root/.foundry/bin/foundryup --install "${FOUNDRY_VERSION}"
ENV PATH="/root/.foundry/bin:${PATH}"

# Verify, and record in the build log which forge actually landed - with a
# floating FOUNDRY_VERSION that is the only place it is written down.
RUN node --version \
 && npm --version \
 && /root/.foundry/bin/forge --version \
 && /root/.foundry/bin/cast --version

# Pre-install common JS deps used by scripts
# Note: keep runtime small; installing project deps happens via CI caches
# Keep image minimal; install project deps (including web3) in CI via pnpm install

# Create working directory
WORKDIR /work

# Default user remains root for CI convenience; adjust if needed
# ENTRYPOINT left default; CI will run job scripts
